{
    "name": "yasinkuyu/omnipay-gvp",
    "type": "library",
    "description": "Garanti BBVA virtual POS (GVP) gateway for Omnipay: hosted payment page (3D_OOS_PAY), 3D Pay, 3D, v512 signing, return verification, refund, void, order inquiry",
    "keywords": ["gvp", "garanti", "garanti bbva", "sanal pos", "3d secure", "ortak odeme sayfasi", "omnipay", "gateway", "payment"],
    "homepage": "https://github.com/yasinkuyu/omnipay-gvp",
    "license": "MIT",
    "authors": [
        {"name": "Yasin Kuyu", "email": "yasinkuyu@gmail.com"},
        {"name": "Contributors", "homepage": "https://github.com/yasinkuyu/omnipay-gvp/contributors"}
    ],
    "autoload": {"psr-4": {"Omnipay\\Gvp\\": "src/"}},
    "autoload-dev": {"psr-4": {"Omnipay\\Gvp\\Tests\\": "tests/"}},
    "require": {
        "php": "^8.1",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "omnipay/common": "^3.3"
    },
    "require-dev": {
        "omnipay/tests": "^4.1",
        "php-http/guzzle7-adapter": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {"branch-alias": {"dev-3.x": "3.x-dev"}},
    "config": {"allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "dev",
    "prefer-stable": true
}
